# Subtext Studio works fully without any environment variables.
# Everything below is OPTIONAL and only enables the AI Creative Assistant.
# Keys are read on the server only (src/app/api/ai/route.ts) and never sent to the browser.

# Option A — Anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5

# Option B — OpenAI-compatible endpoint (AI_MODEL is required)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=
